# Virtual environment
.venv/
venv/

# Python-specific ignores
__pycache__/
*.pyc
*.pyd
*.so
*.dll

# Jupyter Notebook checkpoint files
.ipynb_checkpoints/

# Other common IDE/OS generated files
# Share only the LaTeX Workshop recipe; keep other local VS Code settings untracked.
.vscode/*
!.vscode/settings.json
.DS_Store
Thumbs.db

# Processed data generated from raw sources
data/processed/*
!data/processed/.gitkeep

# Reproducible pipeline generated outputs
output/logs/*
!output/logs/.gitkeep
output/intermediate/*
!output/intermediate/.gitkeep

# Large temporary output artifacts
output/html/*
!output/html/.gitkeep
*.tmp
*.temp

# LaTeX auxiliary files
*.aux
*.log
*.out
*.synctex.gz
*.toc
*.lof
*.lot
*.bbl
*.blg
*.dvi
*.fls
*.fdb_latexmk

# Generated analysis tables
output/tables/*.csv

# PDF file
